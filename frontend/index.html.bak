<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>簡報AI - 專業簡報生成器</title>
    <style>
        :root {
            --primary-color: #4F46E5;
            --primary-hover: #4338CA;
            --secondary-color: #10B981;
            --accent-color: #F59E0B;
            --background: #FFFFFF;
            --surface: #F8FAFC;
            --surface-elevated: #FFFFFF;
            --text-primary: #1F2937;
            --text-secondary: #6B7280;
            --text-muted: #9CA3AF;
            --border: #E5E7EB;
            --border-light: #F3F4F6;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Microsoft JhengHei', 'Segoe UI', Roboto, sans-serif;
            background: var(--surface);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
        }

        .header {
            background: var(--background);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(8px);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-color);
            text-decoration: none;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding: 2rem;
            min-height: calc(100vh - 80px);
        }

        .input-panel, .preview-panel {
            background: var(--surface-elevated);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 2rem;
        }

        .panel-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .panel-subtitle {
            color: var(--text-secondary);
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .text-input {
            width: 100%;
            min-height: 200px;
            padding: 1rem;
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 0.875rem;
            font-family: inherit;
            resize: vertical;
            transition: all 0.2s ease;
            background: var(--background);
        }

        .text-input:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgb(79 70 229 / 0.1);
        }

        .input-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.5rem;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .template-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .template-card {
            border: 2px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            background: var(--background);
        }

        .template-card:hover {
            border-color: var(--primary-color);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .template-card.selected {
            border-color: var(--primary-color);
            background: rgb(79 70 229 / 0.05);
        }

        .template-icon {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .template-name {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .action-buttons {
            display: flex;
            gap: 0.75rem;
        }

        .btn {
            border: none;
            border-radius: var(--radius-md);
            padding: 0.75rem 1.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: var(--primary-color);
            color: white;
            flex: 1;
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-primary:disabled {
            background: var(--text-muted);
            cursor: not-allowed;
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            background: var(--surface);
            color: var(--text-primary);
        }

        .btn-loading::after {
            content: '';
            width: 16px;
            height: 16px;
            margin-left: 0.5rem;
            border: 2px solid currentColor;
            border-radius: 50%;
            border-top-color: transparent;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .preview-panel {
            position: sticky;
            top: 100px;
            height: fit-content;
            max-height: calc(100vh - 120px);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .preview-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 400px;
            color: var(--text-muted);
            text-align: center;
        }

        .preview-empty-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .progress-section {
            display: none;
            padding: 2rem;
            text-align: center;
        }

        .progress-section.show {
            display: block;
        }

        .progress-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--primary-color);
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: var(--border-light);
            border-radius: 4px;
            overflow: hidden;
            margin: 1rem 0;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            width: 0%;
            transition: width 0.3s ease;
        }

        .results-section {
            display: none;
            flex-direction: column;
            height: 100%;
        }

        .results-section.show {
            display: flex;
        }

        .results-header {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
        }

        .slides-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 1rem;
            flex: 1;
            overflow-y: auto;
            margin-bottom: 1.5rem;
        }

        .slide-card {
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            overflow: hidden;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .slide-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            border-color: var(--primary-color);
        }

        .slide-thumbnail {
            aspect-ratio: 16/9;
            background: linear-gradient(135deg, #f8fafc, #e2e8f0);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.75rem;
            position: relative;
        }

        .slide-number {
            position: absolute;
            top: 0.5rem;
            left: 0.5rem;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            font-size: 0.625rem;
            padding: 0.25rem 0.5rem;
            border-radius: 12px;
        }

        .slide-title {
            padding: 0.75rem;
            font-size: 0.75rem;
            font-weight: 500;
            border-top: 1px solid var(--border);
            background: var(--background);
        }

        .export-actions {
            display: flex;
            gap: 0.75rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
        }

        .export-btn {
            flex: 1;
            background: transparent;
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
            border-radius: var(--radius-md);
            padding: 0.75rem;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .export-btn:hover {
            background: var(--primary-color);
            color: white;
        }

        .export-btn.primary {
            background: var(--primary-color);
            color: white;
        }

        .transcript-section {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
        }

        .transcript-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .transcript-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .transcript-style-select {
            padding: 0.5rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.875rem;
            background: var(--background);
            color: var(--text-primary);
            cursor: pointer;
        }

        .transcript-content {
            max-height: 400px;
            overflow-y: auto;
            padding: 1rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 0.875rem;
            line-height: 1.8;
            white-space: pre-wrap;
        }

        .transcript-loading {
            text-align: center;
            color: var(--text-muted);
            padding: 2rem;
        }

        .slide-transcript {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-light);
        }

        .slide-transcript:last-child {
            border-bottom: none;
        }

        .slide-transcript-header {
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }

        .slide-transcript-time {
            color: var(--text-muted);
            font-size: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .slide-transcript-text {
            color: var(--text-primary);
            line-height: 1.8;
        }

        @media (max-width: 1024px) {
            .main-container {
                grid-template-columns: 1fr;
            }
            .preview-panel {
                position: static;
                max-height: none;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="#" class="logo">
                <div class="logo-icon">📊</div>
                簡報AI
            </a>
        </div>
    </header>

    <main class="main-container">
        <section class="input-panel">
            <div class="panel-header">
                <h2 class="panel-title">建立您的簡報</h2>
                <p class="panel-subtitle">輸入您的內容，讓AI為您生成專業簡報</p>
            </div>

            <div class="input-group">
                <label for="content-input" class="input-label">內容輸入</label>
                <textarea 
                    id="content-input" 
                    class="text-input" 
                    placeholder="請在此處貼上或輸入您的內容...

範例：
• 會議記錄
• 課程大綱
• 產品介紹
• 研究成果
• 商業提案

AI 將自動分析您的內容並建立結構化的投影片。"
                ></textarea>
                <div class="input-meta">
                    <span>至少需要 50 個字元</span>
                    <span class="char-count" id="char-count">0 個字元</span>
                </div>
            </div>

            <div class="input-group">
                <label class="input-label">模板樣式</label>
                <div class="template-grid">
                    <div class="template-card selected" data-template="administrative">
                        <div class="template-icon">💼</div>
                        <div class="template-name">行政簡報</div>
                    </div>
                    <div class="template-card" data-template="educational">
                        <div class="template-icon">🎓</div>
                        <div class="template-name">教學簡報</div>
                    </div>
                    <div class="template-card" data-template="general">
                        <div class="template-icon">🎨</div>
                        <div class="template-name">一般簡報</div>
                    </div>
                </div>
            </div>

            <div class="input-group">
                <label for="slide-count" class="input-label">投影片數量</label>
                <select id="slide-count" style="width: 100%; padding: 0.75rem; border: 2px solid var(--border); border-radius: var(--radius-md); font-size: 0.875rem; background: var(--background); color: var(--text-primary); cursor: pointer; transition: all 0.2s ease;">
                    <option value="3">3 張投影片</option>
                    <option value="4">4 張投影片</option>
                    <option value="5">5 張投影片</option>
                    <option value="6" selected>6 張投影片（推薦）</option>
                    <option value="7">7 張投影片</option>
                    <option value="8">8 張投影片</option>
                    <option value="10">10 張投影片</option>
                    <option value="12">12 張投影片</option>
                </select>
                <div class="input-meta" style="margin-top: 0.5rem;">
                    <span style="color: var(--text-muted); font-size: 0.75rem;">⚠️ 超過模板支援的數量將自動調整</span>
                </div>
            </div>

            <div class="action-buttons">
                <button id="generate-btn" class="btn btn-primary" disabled>
                    <span>✨ 生成簡報</span>
                </button>
                <button id="clear-btn" class="btn btn-secondary">
                    <span>🗑️ 清除</span>
                </button>
            </div>
        </section>

        <section class="preview-panel">
            <div id="preview-empty" class="preview-empty">
                <div class="preview-empty-icon">📋</div>
                <div class="preview-empty-text">準備開始建立</div>
                <div class="preview-empty-hint">請輸入您的內容並點擊「生成簡報」來查看預覽</div>
            </div>

            <div id="progress-section" class="progress-section">
                <div class="progress-icon">⚡</div>
                <div class="progress-text" id="progress-text">正在分析內容...</div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progress-fill"></div>
                </div>
                <div class="progress-percentage" id="progress-percentage">0%</div>
            </div>

            <div id="results-section" class="results-section">
                <div class="results-header">
                    <div class="panel-title">簡報已準備完成</div>
                    <div class="results-meta" id="results-meta">已生成 6 張投影片</div>
                </div>

                <div class="slides-grid" id="slides-grid"></div>

                <div class="export-actions">
                    <button class="export-btn primary" id="download-pptx">
                        📄 下載 PowerPoint
                    </button>
                    <button class="export-btn" id="download-pdf">
                        📑 下載 PDF
                    </button>
                    <button class="export-btn" id="generate-transcript">
                        🎤 生成演講稿
                    </button>
                </div>

                <div class="transcript-section" id="transcript-section" style="display: none;">
                    <div class="transcript-header">
                        <h3 class="transcript-title">演講稿</h3>
                        <select id="transcript-style" class="transcript-style-select">
                            <option value="educational">教學式</option>
                            <option value="formal">正式</option>
                            <option value="conversational">對話式</option>
                        </select>
                    </div>
                    <div class="transcript-content" id="transcript-content">
                        <div class="transcript-loading">正在生成演講稿...</div>
                    </div>
                    <button class="export-btn primary" id="download-transcript" style="margin-top: 1rem;">
                        💾 下載演講稿
                    </button>
                </div>
            </div>
        </section>
    </main>

    <script>
        const API_BASE_URL = 'http://localhost:5151/api';

        class PresentationApp {
            constructor() {
                this.selectedTemplate = 'administrative';
                this.currentPresentation = null;
                this.presentationId = null;
                this.init();
            }

            init() {
                this.bindElements();
                this.bindEvents();
                this.updateCharCount();
            }

            bindElements() {
                this.contentInput = document.getElementById('content-input');
                this.charCount = document.getElementById('char-count');
                this.generateBtn = document.getElementById('generate-btn');
                this.clearBtn = document.getElementById('clear-btn');
                
                this.previewEmpty = document.getElementById('preview-empty');
                this.progressSection = document.getElementById('progress-section');
                this.resultsSection = document.getElementById('results-section');
                
                this.progressText = document.getElementById('progress-text');
                this.progressFill = document.getElementById('progress-fill');
                this.progressPercentage = document.getElementById('progress-percentage');
                
                this.slidesGrid = document.getElementById('slides-grid');
                this.resultsMeta = document.getElementById('results-meta');
                
                this.templateCards = document.querySelectorAll('.template-card');
                
                this.transcriptSection = document.getElementById('transcript-section');
                this.transcriptContent = document.getElementById('transcript-content');
                this.transcriptStyle = document.getElementById('transcript-style');
            }

            bindEvents() {
                this.contentInput.addEventListener('input', () => this.updateCharCount());
                this.generateBtn.addEventListener('click', () => this.generatePresentation());
                this.clearBtn.addEventListener('click', () => this.clearContent());
                
                this.templateCards.forEach(card => {
                    card.addEventListener('click', () => this.selectTemplate(card));
                });

                document.getElementById('download-pptx').addEventListener('click', () => {
                    this.downloadFile('pptx');
                });

                document.getElementById('download-pdf').addEventListener('click', () => {
                    this.downloadFile('pdf');
                });

                document.getElementById('generate-transcript').addEventListener('click', () => {
                    this.generateTranscript();
                });

                document.getElementById('download-transcript').addEventListener('click', () => {
                    this.downloadTranscript();
                });
            }

            updateCharCount() {
                const length = this.contentInput.value.length;
                this.charCount.textContent = `${length} 個字元`;
                this.generateBtn.disabled = length < 50;
            }

            selectTemplate(selectedCard) {
                this.templateCards.forEach(card => card.classList.remove('selected'));
                selectedCard.classList.add('selected');
                this.selectedTemplate = selectedCard.dataset.template;
            }

            clearContent() {
                this.contentInput.value = '';
                this.updateCharCount();
                this.showEmptyState();
            }

            async generatePresentation() {
                const content = this.contentInput.value.trim();
                if (content.length < 50) return;

                this.showProgressState();
                this.generateBtn.classList.add('btn-loading');
                this.generateBtn.disabled = true;

                try {
                    // Get user-selected slide count
                    const slideCountSelect = document.getElementById('slide-count');
                    const nSlides = parseInt(slideCountSelect.value);

                    const generateResponse = await fetch(`${API_BASE_URL}/generate`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            content: content,
                            template: this.selectedTemplate,
                            language: 'zh-TW',
                            n_slides: nSlides  // User-specified slide count
                        })
                    });

                    if (!generateResponse.ok) {
                        throw new Error('生成請求失敗');
                    }

                    const { task_id } = await generateResponse.json();
                    await this.pollProgress(task_id);

                } catch (error) {
                    console.error('生成失敗:', error);
                    alert('生成簡報失敗，請稍後再試。\n錯誤: ' + error.message);
                    this.showEmptyState();
                } finally {
                    this.generateBtn.classList.remove('btn-loading');
                    this.generateBtn.disabled = false;
                }
            }

            async pollProgress(taskId) {
                const maxAttempts = 600;  // 10 minutes (600 seconds)
                let attempts = 0;

                const poll = async () => {
                    if (attempts >= maxAttempts) {
                        throw new Error('生成超時');
                    }

                    try {
                        const response = await fetch(`${API_BASE_URL}/progress/${taskId}`);
                        const data = await response.json();

                        this.progressText.textContent = data.current_step || data.message;
                        this.progressFill.style.width = data.progress + '%';
                        this.progressPercentage.textContent = data.progress + '%';

                        if (data.status === 'completed') {
                            this.currentPresentation = data.presentation;
                            this.presentationId = data.presentation_id;
                            this.renderSlides(data.presentation.slides);
                            this.showResultsState();
                            return;
                        } else if (data.status === 'failed') {
                            throw new Error(data.message);
                        }

                        attempts++;
                        setTimeout(poll, 1000);
                    } catch (error) {
                        throw error;
                    }
                };

                await poll();
            }

            renderSlides(slides) {
                this.slidesGrid.innerHTML = '';
                this.resultsMeta.textContent = `已生成 ${slides.length} 張投影片`;

                slides.forEach((slide, index) => {
                    const slideElement = document.createElement('div');
                    slideElement.className = 'slide-card';
                    
                    slideElement.innerHTML = `
                        <div class="slide-thumbnail">
                            <div class="slide-number">${index + 1}</div>
                            <div>${this.getSlideIcon(slide.type)}</div>
                        </div>
                        <div class="slide-title">${slide.title}</div>
                    `;
                    
                    this.slidesGrid.appendChild(slideElement);
                });
            }

            getSlideIcon(type) {
                const icons = {
                    title: '📋',
                    overview: '🗂️',
                    content: '📝',
                    conclusion: '🎯'
                };
                return icons[type] || '📄';
            }

            showEmptyState() {
                this.previewEmpty.style.display = 'flex';
                this.progressSection.classList.remove('show');
                this.resultsSection.classList.remove('show');
            }

            showProgressState() {
                this.previewEmpty.style.display = 'none';
                this.progressSection.classList.add('show');
                this.resultsSection.classList.remove('show');
            }

            showResultsState() {
                this.previewEmpty.style.display = 'none';
                this.progressSection.classList.remove('show');
                this.resultsSection.classList.add('show');
            }

            downloadFile(format) {
                if (!this.presentationId) {
                    alert('請先生成簡報');
                    return;
                }
                
                const downloadUrl = `${API_BASE_URL}/download/${this.presentationId}/${format}`;
                window.open(downloadUrl, '_blank');
            }

            async generateTranscript() {
                if (!this.presentationId) {
                    alert('請先生成簡報');
                    return;
                }

                this.transcriptSection.style.display = 'block';
                this.transcriptContent.innerHTML = '<div class="transcript-loading">正在生成演講稿，請稍候...</div>';

                try {
                    const style = this.transcriptStyle.value;
                    
                    const response = await fetch(`${API_BASE_URL}/transcript/generate`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            presentation_id: this.presentationId,
                            language: 'zh-TW',
                            style: style
                        })
                    });

                    if (!response.ok) {
                        const error = await response.json();
                        throw new Error(error.detail || '生成失敗');
                    }

                    const data = await response.json();
                    this.renderTranscript(data);

                } catch (error) {
                    console.error('生成演講稿失敗:', error);
                    this.transcriptContent.innerHTML = `
                        <div class="transcript-loading" style="color: var(--text-secondary);">
                            ⚠️ 生成演講稿失敗<br>
                            ${error.message}<br><br>
                            ${error.message.includes('phi4-mini') ? 
                                '請先下載 Transcript 模型：<br><code>ollama pull phi4-mini-reasoning:3.8b</code>' : 
                                '請檢查服務狀態並重試'
                            }
                        </div>
                    `;
                }
            }

            renderTranscript(data) {
                const transcripts = data.transcripts || [];
                const totalMinutes = data.total_duration_minutes || 0;

                let html = `
                    <div style="padding: 1rem; background: var(--background); border-radius: var(--radius-sm); margin-bottom: 1rem;">
                        <strong>預估演講時間:</strong> ${totalMinutes} 分鐘 | 
                        <strong>投影片數量:</strong> ${data.total_slides}
                    </div>
                `;

                transcripts.forEach(slide => {
                    const minutes = Math.floor(slide.duration_seconds / 60);
                    const seconds = slide.duration_seconds % 60;
                    const timeStr = minutes > 0 ? 
                        `${minutes}分${seconds}秒` : 
                        `${seconds}秒`;

                    html += `
                        <div class="slide-transcript">
                            <div class="slide-transcript-header">
                                投影片 ${slide.slide_number}: ${slide.title}
                            </div>
                            <div class="slide-transcript-time">
                                預估時間: ${timeStr}
                            </div>
                            <div class="slide-transcript-text">
                                ${slide.transcript}
                            </div>
                        </div>
                    `;
                });

                this.transcriptContent.innerHTML = html;
            }

            downloadTranscript() {
                if (!this.presentationId) {
                    alert('請先生成演講稿');
                    return;
                }

                const downloadUrl = `${API_BASE_URL}/transcript/${this.presentationId}/download`;
                window.open(downloadUrl, '_blank');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            new PresentationApp();
        });
    </script>
</body>
</html>